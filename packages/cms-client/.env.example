# SF-CMS client environment — CANONICAL template
# Copy these exact variable names into every client site. Do NOT invent
# variants (SF_CMS_*, CMS_BASE_URL, PROJECT_ID...) — name drift between the
# build script and runtime code caused a 69-day stale-content bug in prod.

# Public API base of the CMS (no trailing slash)
CMS_API_URL=https://cms.startupsfactory.es/api/public

# Project API key — from the CMS admin (Projects) or returned at registration
CMS_API_KEY=

# Project slug in the CMS `projects` table
CMS_PROJECT_SLUG=

# ── Agent-only (landing-builder Fase 3A) — NEVER copy into a client site ──
# CMS_ADMIN_URL=https://cms.startupsfactory.es
# ADMIN_SECRET=
