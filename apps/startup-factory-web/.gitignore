# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel/
!.vercel/project.json

# typescript
*.tsbuildinfo
next-env.d.ts
content/
.vercel

# resolves deps fresh on every deploy (same pattern as nc-global-assets-next
# — a committed lockfile broke that project's cloud build once, see
# docs/PROJECT_REGISTRY.md)
package-lock.json
