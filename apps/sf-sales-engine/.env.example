# ─── Supabase ───────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# ─── Anthropic ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Notion ─────────────────────────────────────────────────────
NOTION_API_KEY=secret_...
NOTION_VBS_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─── Apollo ─────────────────────────────────────────────────────
APOLLO_API_KEY=...

# ─── Apify ──────────────────────────────────────────────────────
APIFY_API_TOKEN=apify_api_...
APIFY_LINKEDIN_ACTOR_ID=2SyF0bVxmgGr8IVCZ
APIFY_CRUNCHBASE_ACTOR_ID=...
APIFY_DEALROOM_ACTOR_ID=...
APIFY_GMAPS_ACTOR_ID=...

# ─── Hunter.io ──────────────────────────────────────────────────
HUNTER_API_KEY=...

# ─── Tavily / Brave ─────────────────────────────────────────────
TAVILY_API_KEY=tvly-...

# ─── Instantly ──────────────────────────────────────────────────
INSTANTLY_API_KEY=...

# ─── Telegram (hot-lead alerts, icebreaker review, proposal review) ──
# Direct Bot API calls — no n8n needed. Create a bot via @BotFather,
# get chat_id by messaging the bot then hitting /getUpdates once.
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...

# ─── Webhooks (hot-lead, Instantly reply) ───────────────────────
# Shared secret checked against the X-Webhook-Secret header on
# POST /webhooks/*. Leave unset in local dev to skip the check.
WEBHOOK_SECRET=...

# ─── Upstash Redis (Arq worker) ─────────────────────────────────
REDIS_URL=rediss://default:...@...upstash.io:6379

# ─── App ────────────────────────────────────────────────────────
ENVIRONMENT=development   # development | production
LOG_LEVEL=INFO
