{
  "name": "[CLIENT]_OUTREACH_ICEBREAKER_GENERATOR",
  "description": "Genera icebreaker ultrapersonalizado consumiendo el Commercial Brain",
  "nodes": [
    {
      "id": "input",
      "name": "Input: Lead Data",
      "type": "n8n-nodes-base.noOp",
      "parameters": {}
    },
    {
      "id": "fetch_brain",
      "name": "Fetch Commercial Brain",
      "type": "n8n-nodes-base.supabase",
      "parameters": {
        "operation": "getAll",
        "tableId": "icp_profiles",
        "filters": { "client_id": "={{ $json.client_id }}" }
      }
    },
    {
      "id": "fetch_context",
      "name": "Fetch Prospect Context",
      "type": "n8n-nodes-base.supabase",
      "parameters": {
        "operation": "getAll",
        "tableId": "prospect_context",
        "filters": { "lead_id": "={{ $json.lead_id }}" }
      }
    },
    {
      "id": "claude_icebreaker",
      "name": "Claude Sonnet: Generate Icebreaker",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "parameters": {
        "model": "claude-sonnet-4-6",
        "systemPrompt": "={{ $('fetch_brain').item.json }}",
        "prompt": "Lee prompts/outreach/cold-icebreaker.md v1.0. Genera el icebreaker para este prospect."
      }
    },
    {
      "id": "human_review",
      "name": "Human Review (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "parameters": {
        "text": "✉️ *Icebreaker para aprobación*\nPara: {{ $json.first_name }} @ {{ $json.company_name }}\n\n{{ $('claude_icebreaker').item.json.text }}\n\n✅ /aprobar_{{ $json.lead_id }}\n❌ /rechazar_{{ $json.lead_id }}"
      }
    }
  ],
  "connections": {
    "input": { "main": [[ { "node": "fetch_brain" }, { "node": "fetch_context" } ]] },
    "fetch_brain": { "main": [[ { "node": "claude_icebreaker" } ]] },
    "claude_icebreaker": { "main": [[ { "node": "human_review" } ]] }
  }
}
