{
  "name": "[CLIENT]_PROPOSALS_BRIEF_TO_PROPOSAL",
  "description": "Brief de llamada → propuesta personalizada en Google Docs / PPTX via Claude Sonnet",
  "nodes": [
    { "id": "form_trigger", "name": "Call Brief Form (Tally)", "type": "n8n-nodes-base.webhook", "parameters": { "path": "call-brief" } },
    { "id": "fetch_brain", "name": "Fetch Commercial Brain", "type": "n8n-nodes-base.supabase",
      "parameters": { "operation": "getAll", "tableId": "proposal_library", "limit": 3 }
    },
    { "id": "claude_proposal", "name": "Claude Sonnet: Generate Proposal",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "parameters": { "model": "claude-sonnet-4-6", "prompt": "Lee prompts/proposals/proposal-generator.md. Genera la propuesta." }
    },
    { "id": "create_gdoc", "name": "Create Google Doc", "type": "n8n-nodes-base.googleDocs",
      "parameters": { "operation": "create", "title": "Propuesta {{ $json.company_name }} — {{ $now.format('YYYY-MM-DD') }}" }
    },
    { "id": "notify_team", "name": "Notify via Telegram", "type": "n8n-nodes-base.telegram",
      "parameters": { "text": "📄 Propuesta lista para {{ $json.company_name }}: {{ $('create_gdoc').item.json.url }}" }
    }
  ],
  "connections": {
    "form_trigger": { "main": [[ { "node": "fetch_brain" } ]] },
    "fetch_brain": { "main": [[ { "node": "claude_proposal" } ]] },
    "claude_proposal": { "main": [[ { "node": "create_gdoc" } ]] },
    "create_gdoc": { "main": [[ { "node": "notify_team" } ]] }
  }
}
