{
  "name": "[CLIENT]_QUALIFICATION_REPLY_CLASSIFIER",
  "description": "Instantly webhook → clasifica respuesta → hot/warm/cold/disqualify → actualiza Supabase",
  "nodes": [
    { "id": "instantly_webhook", "name": "Instantly Reply Webhook", "type": "n8n-nodes-base.webhook", "parameters": { "path": "instantly-reply" } },
    { "id": "classify", "name": "Claude Haiku: Classify Reply",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "parameters": { "model": "claude-haiku-4-5-20251001", "prompt": "Lee prompts/qualification/reply-classifier.md. Clasifica esta respuesta." }
    },
    { "id": "update_stage", "name": "Update Lead Stage", "type": "n8n-nodes-base.supabase",
      "parameters": { "operation": "update", "tableId": "leads" }
    },
    { "id": "route_hot", "name": "Route: Hot?", "type": "n8n-nodes-base.if",
      "parameters": { "conditions": { "string": [{ "value1": "={{ $json.classification }}", "value2": "hot" }] } }
    },
    { "id": "schedule_vapi", "name": "Schedule Vapi Call", "type": "n8n-nodes-base.executeWorkflow",
      "parameters": { "workflowId": "qualification/vapi-call-scheduler" }
    }
  ],
  "connections": {
    "instantly_webhook": { "main": [[ { "node": "classify" } ]] },
    "classify": { "main": [[ { "node": "update_stage" } ]] },
    "update_stage": { "main": [[ { "node": "route_hot" } ]] },
    "route_hot": { "main": [[ { "node": "schedule_vapi" } ], []] }
  }
}
