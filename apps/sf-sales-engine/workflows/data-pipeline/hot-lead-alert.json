{
  "name": "GLOBAL_DATA_PIPELINE_HOT_LEAD_ALERT",
  "description": "Supabase Realtime → detecta hot leads (score>75) → Telegram + encola icebreaker",
  "nodes": [
    {
      "id": "supabase_realtime",
      "name": "Supabase Realtime: leads INSERT",
      "type": "n8n-nodes-base.supabaseTrigger",
      "parameters": { "event": "INSERT", "table": "leads", "filter": "hot_score=gte.75" }
    },
    {
      "id": "telegram_hot",
      "name": "Telegram Hot Lead Alert",
      "type": "n8n-nodes-base.telegram",
      "parameters": {
        "text": "🔥 *HOT LEAD* (score={{ $json.hot_score }})\n{{ $json.first_name }} {{ $json.last_name }} — {{ $json.title }} @ {{ $json.company_name }}\nTrigger: {{ $json.trigger_event }}"
      }
    },
    {
      "id": "trigger_icebreaker",
      "name": "Trigger Icebreaker Workflow",
      "type": "n8n-nodes-base.executeWorkflow",
      "parameters": { "workflowId": "outreach/icebreaker-generator" }
    }
  ],
  "connections": {
    "supabase_realtime": { "main": [[ { "node": "telegram_hot" }, { "node": "trigger_icebreaker" } ]] }
  }
}
