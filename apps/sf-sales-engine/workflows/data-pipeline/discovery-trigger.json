{
  "name": "GLOBAL_DATA_PIPELINE_DAILY_DISCOVERY",
  "description": "Trigger diario que llama POST /discovery/run para cada cliente activo",
  "nodes": [
    {
      "id": "schedule",
      "name": "Daily 6am UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 6 * * *" }] } }
    },
    {
      "id": "get_clients",
      "name": "Get Active Clients",
      "type": "n8n-nodes-base.supabase",
      "parameters": { "operation": "getAll", "tableId": "icp_profiles", "filters": {} }
    },
    {
      "id": "trigger_pipeline",
      "name": "POST /discovery/run",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_BASE_URL }}/discovery/run",
        "body": { "client_id": "={{ $json.client_id }}", "icp_id": "={{ $json.id }}" }
      }
    },
    {
      "id": "telegram_notify",
      "name": "Notify Telegram",
      "type": "n8n-nodes-base.telegram",
      "parameters": { "text": "🔍 Discovery run iniciado para {{ $json.client_id }}" }
    }
  ],
  "connections": {
    "schedule": { "main": [[ { "node": "get_clients" } ]] },
    "get_clients": { "main": [[ { "node": "trigger_pipeline" } ]] },
    "trigger_pipeline": { "main": [[ { "node": "telegram_notify" } ]] }
  }
}
