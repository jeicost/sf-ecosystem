NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Claude API (required)
ANTHROPIC_API_KEY=your-anthropic-api-key

# External integrations (optional)
APOLLO_API_KEY=your-apollo-key-for-lead-discovery
TAVILY_API_KEY=your-tavily-key-for-research
WEBHOOK_SECRET=your-webhook-signing-secret

# Google Drive Integration (optional)
# Get these from Google Cloud Console:
# 1. Create service account in Google Cloud Project
# 2. Download JSON key
# 3. Share a Drive folder with service account email
# 4. Replace these with your actual values
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
GOOGLE_DRIVE_FOLDER_ID=your-shared-folder-id

# ── Email Ops (bandeja operativa por correo, lib/email-ops) ──────────────────
# Resend Inbound: API key de la cuenta SF (la misma que sf-crm) y el secreto de
# firma del webhook (Resend → Webhooks → email.received → Signing secret).
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Dominio de recepción configurado en Resend (p. ej. in.mira.startupsfactory.es o <id>.resend.app)
EMAIL_OPS_INBOUND_DOMAIN=
# Opcionales: modelo de extracción (default claude-sonnet-4-6) y tope diario de análisis por cliente (500)
# EMAIL_OPS_MODEL=
# EMAIL_OPS_DAILY_CAP=

# ── Cobro (Stripe) — sin estas claves /billing dice la verdad: "aún no se puede pagar" ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STARTER_MULTI=
# STRIPE_PRICE_BRAND=
# STRIPE_PRICE_GROWTH=
# STRIPE_PRICE_BRAND_HOUSE=
STRIPE_PRICE_IMAGE_PACK=

# ── Observabilidad (Sentry) — sin DSN, Sentry.init es un no-op limpio ──
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=            # solo para subir source maps en build

# ── Seguridad y límites ──
# Cifra las API keys BYO de clientes (AES-256-GCM). En producción SIN esta
# clave el guardado de secretos FALLA a propósito (lib/crypto.ts).
MIRA_ENCRYPTION_KEY=
# Techo de generaciones/mes con key de plataforma por cliente (sin valor = sin techo)
MAX_MONTHLY_GENERATIONS=
# CSV de client UUIDs exentos del techo
GENERATION_CAP_EXEMPT_CLIENTS=
# Bearer que valida los 4 crons de vercel.json
CRON_SECRET=
# Secreto del batch de generación server-to-server
BATCH_SECRET=

# ── Flags de producto ──
ENFORCE_PLAN_LIMITS=
NEXT_PUBLIC_GOALS_ENABLED=
DRIVE_BRAIN_SYNTHESIS=

# ── URL pública (emails de invitación; sin ella cae a la URL de preview) ──
NEXT_PUBLIC_APP_URL=https://mira.startupsfactory.es
