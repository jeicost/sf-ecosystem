{
  "buildCommand": "cd ../.. && turbo run build --filter=mira-portal...",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "env": {
    "NODE_ENV": "production"
  },
  "crons": [
    { "path": "/api/cron/drive-sync", "schedule": "0 5 * * *" },
    { "path": "/api/cron/brain-lint", "schedule": "0 6 * * 0" },
    { "path": "/api/cron/email-ops", "schedule": "*/10 * * * *" }
  ]
}
