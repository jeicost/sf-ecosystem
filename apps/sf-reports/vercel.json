{
  "buildCommand": "",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/seo", "destination": "/dadybox/seo", "permanent": false },
    { "source": "/marketing", "destination": "/dadybox/marketing", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
