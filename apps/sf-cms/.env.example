# Supabase (SF-CMS dedicated project dmzecrlkclocqaywkjtc)
NEXT_PUBLIC_SUPABASE_URL=https://dmzecrlkclocqaywkjtc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[from Supabase dashboard - Settings > API > Project API keys > anon]
SUPABASE_SERVICE_ROLE_KEY=[from Supabase dashboard - Settings > API > Project API keys > service_role]

# Admin Auth (simple shared password)
ADMIN_PASSWORD=[set to a secure password, or default 'admin' for dev]
ADMIN_SECRET=[generate with: openssl rand -hex 32 - used for project creation API calls]

# AI (Anthropic Claude API)
ANTHROPIC_API_KEY=[from https://console.anthropic.com/keys]

# ISR Revalidation (for client websites consuming this CMS)
NEXT_PUBLIC_REVALIDATE_SECRET=[generate with: openssl rand -hex 32]

# Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3002
