{
  "name": "sf-cms",
  "version": "1.0.0",
  "description": "SF-CMS — Headless content management system for Startup Factory landing sites",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:link": "supabase link --project-ref dmzecrlkclocqaywkjtc",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff --linked",
    "db:backup": "node scripts/backup-cms.mjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "@supabase/ssr": "^0.6.1",
    "@anthropic-ai/sdk": "^0.39.0",
    "lucide-react": "^0.344.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@tiptap/extension-link": "^3.28.0",
    "@sentry/node": "^9.0.0",
    "@tiptap/extension-image": "^3.28.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.3.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.54.0",
    "eslint-config-next": "^16.0.0",
    "supabase": "^2.0.0"
  }
}
