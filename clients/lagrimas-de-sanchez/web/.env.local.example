# ── Stripe ───────────────────────────────────────────────────────────────
# sk_test_… para probar, sk_live_… en producción.
STRIPE_SECRET_KEY=

# El whsec_… del endpoint que se crea en el panel de Stripe apuntando a
# https://lagrimasdesanchez.com/api/stripe-webhook
# Sin esto el webhook devuelve 503 y NINGÚN pago se da por bueno.
STRIPE_WEBHOOK_SECRET=

# "1" activa el cálculo automático de IVA por país de destino.
# Requiere haber activado Stripe Tax en el panel Y dado de alta la dirección
# de origen. Si no está, déjalo vacío: activarlo sin configurar tumba todas
# las compras.
STRIPE_TAX=

# ── Sitio ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://lagrimasdesanchez.com

# Buzón al que llegan los pedidos. Si se deja vacío usa hola@lagrimasdesanchez.com
PEDIDOS_EMAIL=

# ── SF-CMS (opcional) ────────────────────────────────────────────────────
# Si no responde, el build sigue con el copy del código. Nunca bloquea.
CMS_API_URL=https://cms.startupsfactory.es
CMS_CLIENT_SLUG=lagrimas-de-sanchez
CMS_API_KEY=
