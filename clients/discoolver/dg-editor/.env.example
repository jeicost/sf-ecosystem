# ─────────────────────────────────────────────────────────────────────────────
# Discoolver Guides — Editor & Portal
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el .env real al repositorio.
# ─────────────────────────────────────────────────────────────────────────────


# ── IA ────────────────────────────────────────────────────────────────────────
# Claude (Anthropic) — Tab IA del editor
ANTHROPIC_API_KEY=sk-ant-...

# Freepik — generación de portadas con IA (Tab Media y Tab Portada)
# Sin esta key el botón "Generar con IA" no aparece en el editor
FREEPIK_API_KEY=


# ── Base de datos ─────────────────────────────────────────────────────────────
# Desarrollo local (SQLite, sin configuración extra):
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Producción (PostgreSQL en DigitalOcean App Platform):
# DATABASE_URL=postgresql+asyncpg://discoolver:PASSWORD@host:5432/discoolver_guides


# ── Auth / JWT ────────────────────────────────────────────────────────────────
# OBLIGATORIO cambiar en producción. Genera con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-en-produccion
JWT_SECRET=cambia-esto-en-produccion

JWT_EXPIRE_MINUTES=10080
ACCESS_TOKEN_EXPIRE_MINUTES=1440


# ── CMS Discoolver (api.discoolver.com) ───────────────────────────────────────
# Credenciales del usuario CMS que usa el editor para importar recomendados.
# ⚠️  El Tab CMS quedará bloqueado hasta que Diego active los endpoints
#     /cms/v1/city, /cms/v1/category y /cms/v1/business en el backend.
CMS_API_URL=https://api.discoolver.com
CMS_API_USER=atenea
CMS_API_PASSWORD=


# ── Cloudflare R2 (almacenamiento de imágenes, S3-compatible) ────────────────
# Sin configurar → las imágenes se guardan en static/generated/ (solo local).
# Los archivos se suben bajo el prefijo /files dentro del bucket.
# Obtener credenciales en: Cloudflare Dashboard → R2 → Manage R2 API Tokens
DO_SPACES_KEY=           # R2 Access Key ID
DO_SPACES_SECRET=        # R2 Secret Access Key
DO_SPACES_BUCKET=discoolver-guides
DO_SPACES_REGION=auto    # R2 siempre usa "auto"
# Endpoint de jurisdicción S3 — en CF Dashboard → R2 → bucket → Settings
DO_SPACES_ENDPOINT=https://[account-id].r2.cloudflarestorage.com
# Opcional: dominio público custom (ej. https://media.discoolver.com)
# Sin esto, las URLs públicas usan el endpoint R2 directamente
DO_SPACES_CDN_BASE=


# ── Instagram / Meta OAuth ────────────────────────────────────────────────────
# Necesario para el OAuth del portal de influencers.
# ⚠️  Diego / equipo Discoolver deben crear la Meta App y proporcionar estos valores.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Registrar estas URLs exactas en la Meta App → Productos → Instagram → OAuth
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v2/instagram/callback
INSTAGRAM_USER_REDIRECT_URI=http://localhost:8000/api/v2/instagram/user-callback


# ── Email / SMTP ──────────────────────────────────────────────────────────────
# En desarrollo desactivado (EMAIL_ENABLED=false): los emails no se envían.
# En producción activar y configurar. Ver "Configurar emails" en DEPLOY.md.
#
# Opciones recomendadas:
#   Gmail SMTP:  smtp.gmail.com  puerto 587  (requiere App Password)
#   SendGrid:    smtp.sendgrid.net  puerto 587
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Discoolver <hola@discoolver.com>
# Email que recibe notificaciones de nuevas aplicaciones de influencers:
ADMIN_EMAIL=hola@discoolver.com
# URL base del portal (se incluye en los emails enviados a influencers):
PORTAL_URL=https://discoolver.com/portal


# ── Servidor ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# CORS: en producción reemplazar * por dominios reales separados por coma.
# Ejemplo: CORS_ORIGINS=https://editor.discoolver.com,https://discoolver.com
CORS_ORIGINS=*


# ── Rate limiting IA ──────────────────────────────────────────────────────────
AI_RATE_LIMIT=20
AI_RATE_WINDOW=60
