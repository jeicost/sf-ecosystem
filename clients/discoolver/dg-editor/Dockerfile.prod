# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copiar editor
COPY editor/package*.json ./editor/
RUN cd editor && npm ci

COPY editor/ ./editor/

# Build Vite con modo production
ENV VITE_API_BASE=https://api.discoolver.com/cms
RUN cd editor && npm run build

# Runtime stage
FROM node:20-alpine

WORKDIR /app

# Instalar servidor web minimalista
RUN npm install -g serve

# Copiar solo dist del build
COPY --from=builder /app/editor/dist ./dist

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1

# Exponer puerto
EXPOSE 3000

# Variables de entorno
ENV NODE_ENV=production
ENV VITE_API_BASE=${VITE_API_BASE:-https://api.discoolver.com/cms}

# Servir dist con serve (soporta SPA routing)
CMD ["serve", "-s", "dist", "-l", "3000"]
