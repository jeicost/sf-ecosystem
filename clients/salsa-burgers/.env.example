# Salsa Burgers — Environment Variables

# CMS Integration (SF-CMS)
# The fetch script accepts these SF_CMS_* names or the legacy CMS_* names.
# URL must include /api/public — the script appends /posts, /pages, /settings.
SF_CMS_API_URL=https://cms.startupsfactory.es/api/public
SF_CMS_API_KEY=sk_xxxxx
SF_CMS_PROJECT_SLUG=salsaburgers

# ISR Revalidation (Supabase webhook)
REVALIDATE_SECRET=sk_xxxxx

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
